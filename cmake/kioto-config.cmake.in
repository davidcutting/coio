@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/kioto-targets.cmake")

check_required_components(kioto)

set(_kioto_senders_backend "@KIOTO_SENDERS_BACKEND@")

if(_kioto_senders_backend STREQUAL "NVIDIA")
    find_dependency(stdexec REQUIRED)
    set_property(TARGET kioto::kioto APPEND PROPERTY INTERFACE_LINK_LIBRARIES STDEXEC::stdexec)
elseif(_kioto_senders_backend STREQUAL "BEMAN")
    find_dependency(beman.execution REQUIRED)
    set_property(TARGET kioto::kioto APPEND PROPERTY INTERFACE_LINK_LIBRARIES beman::execution_headers)
endif()

if(@Liburing_FOUND@)
    list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
    find_dependency(Liburing)
endif()

unset(_kioto_senders_backend)