doctest_dep = dependency('doctest')  # subprojects/doctest.wrap fallback

test_names = [
  'test_async_latch',
  'test_async_mutex',
  'test_async_semaphore',
  'test_capability_resolution',
  'test_completion_driver_contract',
  'test_driver_init',
  'test_endpoint',
  'test_fault_injection',
  'test_fifo',
  'test_fixed_string',
  'test_generator',
  'test_heterogeneous_runtime',
  'test_inplace_vector',
  'test_intrusive_list',
  'test_io_accept_sequence',
  'test_io_backpressure',
  'test_io_cancel_ops',
  'test_io_composed',
  'test_io_errors',
  'test_io_file',
  'test_io_multishot',
  'test_io_pipe',
  'test_io_receive_sequence',
  'test_io_tcp',
  'test_io_teardown_stress',
  'test_io_udp',
  'test_metrics',
  'test_timers',
  'test_polymorphic_scheduler',
  'test_resolver',
  'test_runtime_balanced',
  'test_runtime_builder',
  'test_runtime_cancel',
  'test_runtime_routing',
  'test_runtime_shutdown',
  'test_runtime_with_mock_worker',
  'test_scope_exit',
  'test_signal_wait',
  'test_soak',
  'test_socket_options',
  'test_task',
  'test_thread_affinity',
  'test_time_loop',
  'test_type_list',
  'test_worker_with_mock_source',
  'test_zstring_view',
]

foreach name : test_names
  exe = executable(name, files(name + '.cpp'),
    dependencies : [kioto_dep, doctest_dep],
    cpp_args : ['-DDOCTEST_CONFIG_IMPLEMENT_WITH_MAIN'],
  )
  test(name, exe)
endforeach
